{
  "agents": [
    {
      "agent_id": "_default",
      "grants": [
        {"capability": "file:read"},
        {"capability": "file:write"},
        {"capability": "code:execute"},
        {"capability": "memory:read"},
        {"capability": "memory:write"}
      ],
      "deny": [
        "network:fetch", "channel:send", "schedule:create",
        "system:admin", "tool:invoke"
      ]
    }
  ]
}
